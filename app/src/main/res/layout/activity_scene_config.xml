<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_chat"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="48dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvSceneTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvSceneSsid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#CDEBFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvAliasGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="&#x4F60;&#x53EF;&#x4EE5;&#x5728;&#x804A;&#x5929;&#x9875;&#x76F4;&#x63A5;&#x8BF4;&#x201C;&#x628A;&#x5F53;&#x524D; Wi-Fi &#x53EB;&#x505A;&#x5BB6;&#x201D;&#x6765;&#x8BBE;&#x7F6E;&#x522B;&#x540D;&#x3002;&#x8FD9;&#x91CC;&#x4E5F;&#x53EF;&#x4EE5;&#x624B;&#x52A8;&#x4FEE;&#x6539;&#xFF0C;&#x7528;&#x4E8E;&#x5907;&#x7528;&#x548C;&#x6821;&#x5BF9;&#x3002;"
                android:textColor="#AFCBE8"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etSceneAlias"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_option_inactive"
                android:hint="&#x522B;&#x540D;&#xFF0C;&#x4F8B;&#x5982;&#xFF1A;&#x5BB6;"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#7DA6C8" />

            <TextView
                android:id="@+id/tvAliasMissingHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="&#x8FD8;&#x6CA1;&#x6709;&#x522B;&#x540D;&#xFF1A;&#x4F60;&#x53EF;&#x4EE5;&#x76F4;&#x63A5;&#x5BF9; AI &#x8BF4;&#x201C;&#x628A;&#x5F53;&#x524D; Wi-Fi &#x53EB;&#x505A;&#x5BB6;&#x201D;"
                android:textColor="#FFD477"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSaveAlias"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_option_active"
                android:text="&#x4FDD;&#x5B58;&#x522B;&#x540D;"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="&#x89E6;&#x53D1;&#x65F6;&#x673A;"
                android:textColor="#CDEBFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spEventType"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="&#x5F00;&#x5173;&#x914D;&#x7F6E;"
                android:textColor="#CDEBFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="&#x84DD;&#x7259;"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBluetoothKeep"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="&#x4E0D;&#x914D;&#x7F6E;"
                    android:textAllCaps="false"
                    android:textColor="#EAF4FF" />

                <Button
                    android:id="@+id/btnBluetoothOff"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="&#x5173;"
                    android:textAllCaps="false"
                    android:textColor="#EAF4FF" />

                <Button
                    android:id="@+id/btnBluetoothOn"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="&#x5F00;"
                    android:textAllCaps="false"
                    android:textColor="#EAF4FF" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="&#x6570;&#x503C;&#x914D;&#x7F6E;"
                android:textColor="#CDEBFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBrightnessLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="&#x4EAE;&#x5EA6;"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnBrightnessKeep"
                    android:layout_width="86dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:text="&#x4E0D;&#x914D;&#x7F6E;"
                    android:textAllCaps="false"
                    android:textColor="#EAF4FF" />

                <Button
                    android:id="@+id/btnBrightnessConfig"
                    android:layout_width="86dp"
                    android:layout_height="36dp"
                    android:text="&#x914D;&#x7F6E;"
                    android:textAllCaps="false"
                    android:textColor="#EAF4FF" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbBrightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:min="0"
                android:progress="50" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="#3A5E85AA" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvVolumeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="&#x97F3;&#x91CF;"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnVolumeKeep"
                    android:layout_width="86dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:text="&#x4E0D;&#x914D;&#x7F6E;"
                    android:textAllCaps="false"
                    android:textColor="#EAF4FF" />

                <Button
                    android:id="@+id/btnVolumeConfig"
                    android:layout_width="86dp"
                    android:layout_height="36dp"
                    android:text="&#x914D;&#x7F6E;"
                    android:textAllCaps="false"
                    android:textColor="#EAF4FF" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:min="0"
                android:progress="50" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveScene"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_send_button"
            android:text="&#x4FDD;&#x5B58;&#x914D;&#x7F6E;"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDeleteScene"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_danger"
            android:text="&#x5220;&#x9664;&#x573A;&#x666F;"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>

